-- Reference solutions of the subsequence-counting family (bead P3.6), in dc
-- surface syntax, compiled against the prelude. Each variant counts the
-- subsets of the list's positions (the empty one included) whose chosen
-- values, in order of position, satisfy a rule, mod 1000003. Each has three
-- references:
--
-- * naive (2^n): every subset is enumerated by choosing or skipping each
--   position in turn, carrying the rule's state; a broken rule is carried to
--   the end rather than cut off, so every subset is visited.
-- * quadratic (n^2): for each position j, the subsets whose last chosen
--   position is j, from those whose last chosen position is before j, summed
--   afresh at every j.
-- * good (n): one pass carrying, for every value of a small state, the
--   number of subsets of the prefix in that state.
--
-- A condition that only picks which number to add is written as a factor
-- (if c then 1 else 0) * x, so that both cases cost the same and the step
-- counts barely depend on the values.

let addm a b = (a + b) mod 1000003

let absdiff x y = if x <= y then y - x else x - y

let norm7 v = ((v mod 7) + 7) mod 7

let add_arrays k a b = array_tabulate k (fun r -> addm (array_get a r) (array_get b r))

-- (a) Sum mod 7: the chosen values sum to a multiple of 7.

let sum_mod_7_naive xs =
  bfix (length xs + 1)
    (fun self ys s ->
      match ys with
      | [] -> if s mod 7 = 0 then 1 else 0
      | y :: rest -> addm (self rest (s + y)) (self rest s))
    xs 0

-- The counts by sum mod 7 of the subsets whose last chosen value is x, given
-- the counts `before` of the subsets that end before it (the empty one
-- included).
let sum_mod_7_end before x =
  array_tabulate 7 (fun r -> array_get before (norm7 (r - x)))

let sum_mod_7_quadratic xs =
  let empty = array_tabulate 7 (fun r -> if r = 0 then 1 else 0) in
  let ends =
    foldl
      (fun ends x -> sum_mod_7_end (foldl (add_arrays 7) empty ends) x :: ends)
      [] xs in
  array_get (foldl (add_arrays 7) empty ends) 0

let sum_mod_7_good xs =
  let empty = array_tabulate 7 (fun r -> if r = 0 then 1 else 0) in
  let counts =
    foldl
      (fun c x ->
        array_tabulate 7 (fun r -> addm (array_get c r) (array_get c (norm7 (r - x)))))
      empty xs in
  array_get counts 0

-- (b) Close steps: consecutive chosen values differ by at most 2. Values are
-- in 0..9.

-- st: 0 before anything is chosen, 1 while the rule holds, 2 once broken.
let close_steps_naive xs =
  bfix (length xs + 1)
    (fun self ys st last ->
      match ys with
      | [] -> if st = 2 then 0 else 1
      | y :: rest ->
        let far = (if st = 1 then 1 else 0) * (if absdiff y last > 2 then 1 else 0) in
        let st2 = if st + far >= 2 then 2 else 1 in
        addm (self rest st2 y) (self rest st last))
    xs 0 0

let close_steps_quadratic xs =
  let ends =
    foldl
      (fun ends x ->
        let f =
          foldl
            (fun acc (y, g) -> addm acc ((if absdiff x y <= 2 then 1 else 0) * g))
            1 ends in
        (x, f) :: ends)
      [] xs in
  foldl (fun acc (_, g) -> addm acc g) 1 ends

-- c holds, at index v + 2, the subsets of the prefix whose last chosen value
-- is v; indices 0, 1, 12 and 13 stay 0, so the five values x - 2 .. x + 2
-- are always the indices x .. x + 4.
let close_steps_good xs =
  let (_, total) =
    foldl
      (fun (c, total) x ->
        let f = loop 5 1 (fun d acc -> addm acc (array_get c (x + d))) in
        (array_set c (x + 2) (addm (array_get c (x + 2)) f), addm total f))
      (array_tabulate 14 (fun _ -> 0), 1) xs in
  total

-- (c) No three in a row: no three consecutive positions are all chosen. The
-- values do not matter.

-- r: the chosen positions in a row at the end of the prefix, or 3 once the
-- rule is broken.
let no_three_in_a_row_naive xs =
  bfix (length xs + 1)
    (fun self ys r ->
      match ys with
      | [] -> if r = 3 then 0 else 1
      | _ :: rest ->
        addm
          (self rest (if r >= 2 then 3 else r + 1))
          (self rest (if r = 3 then 3 else 0)))
    xs 0

-- ends holds, most recent first, the subsets whose last chosen position is
-- each earlier j. Those ending at j with j - 1 not chosen extend any subset
-- ending at j - 2 or before (or the empty one); those with j - 1 chosen are
-- the ones ending at j - 1 with j - 2 not chosen (prev).
let no_three_in_a_row_quadratic xs =
  let (ends, _) =
    foldl
      (fun (ends, prev) _ ->
        let older = (match ends with | [] -> [] | _ :: o -> o) in
        let alone = foldl addm 1 older in
        (addm alone prev :: ends, alone))
      ([], 0) xs in
  foldl addm 1 ends

-- (a0, a1, a2): the subsets of the prefix ending in 0, 1 or 2 chosen
-- positions in a row.
let no_three_in_a_row_good xs =
  let (a0, a1, a2) =
    foldl (fun (a0, a1, a2) _ -> (addm a0 (addm a1 a2), a0, a1)) (1, 0, 0) xs in
  addm a0 (addm a1 a2)

-- (d) Zigzag: the chosen values go strictly up and down in turn (either
-- first). Values are in 0..9.

-- -1, 0 or 1 as y is below, equal to or above x, at the same cost each way.
let cmp x y = (if x < y then 1 else 0) - (if y < x then 1 else 0)

-- phase: 0 nothing chosen, 1 one value chosen, 2 the last step went up,
-- 3 it went down, 4 the rule is broken. The next phase on choosing y after
-- last is at index 3 phase + cmp last y + 1 of the table, so every step
-- costs the same.
let zigzag_naive xs =
  let table = array_of_list [1; 1; 1; 3; 4; 2; 3; 4; 4; 4; 4; 2; 4; 4; 4] in
  let zigzag_step phase last y = array_get table (3 * phase + cmp last y + 1) in
  bfix (length xs + 1)
    (fun self ys phase last ->
      match ys with
      | [] -> if phase = 4 then 0 else 1
      | y :: rest -> addm (self rest (zigzag_step phase last y) y) (self rest phase last))
    xs 0 0

-- For each earlier position: its value and the subsets of two or more
-- positions ending there whose last step went up (u) and down (d). A subset
-- ending at y extends upwards to x if y < x and it is y alone or went down.
let zigzag_quadratic xs =
  let ends =
    foldl
      (fun ends x ->
        let (u, d) =
          foldl
            (fun (u, d) (y, uy, dy) ->
              ( addm u ((if y < x then 1 else 0) * addm 1 dy),
                addm d ((if y > x then 1 else 0) * addm 1 uy) ))
            (0, 0) ends in
        (x, u, d) :: ends)
      [] xs in
  foldl (fun acc (_, u, d) -> addm acc (addm 1 (addm u d))) 1 ends

-- a[v]: the subsets ending in value v that may next go up (v alone, or the
-- last step went down); b[v]: those that may next go down.
let zigzag_good xs =
  let zero10 = array_tabulate 10 (fun _ -> 0) in
  let (_, _, total) =
    foldl
      (fun (a, b, total) x ->
        let up = loop 10 0 (fun v acc -> addm acc ((if v < x then 1 else 0) * array_get a v)) in
        let down = loop 10 0 (fun v acc -> addm acc ((if v > x then 1 else 0) * array_get b v)) in
        ( array_set a x (addm (array_get a x) (addm 1 down)),
          array_set b x (addm (array_get b x) (addm 1 up)),
          addm total (addm 1 (addm up down)) ))
      (zero10, zero10, 1) xs in
  total

-- (e) Sign changes: at most m sign changes between consecutive non-zero
-- chosen values. 0 has no sign.

let sign y = (if y > 0 then 1 else 0) - (if y < 0 then 1 else 0)

let flag b = if b then 1 else 0

let sign_changes_naive xs m =
  bfix (length xs + 1)
    (fun self ys c s ->
      match ys with
      | [] -> if c <= m then 1 else 0
      | y :: rest ->
        let sy = sign y in
        let c2 = c + (1 - flag (sy = 0)) * (1 - flag (s = 0)) * (1 - flag (s = sy)) in
        let s2 = if sy = 0 then s else sy in
        addm (self rest c2 s2) (self rest c s))
    xs 0 0

-- The state (c, s) is at index 3 c + s + 1: c sign changes so far, cut at
-- w - 1, and s the sign of the last non-zero chosen value, 0 if none. The
-- width w = max m 4 + 2 is the same for every m up to 4, so the cost does
-- not depend on m there; index c = w - 1 > m holds the subsets with too many.
let sc_width m = max m 4 + 2

let sc_get a c s = if c < 0 then 0 else array_get a (3 * c + s + 1)

-- The subsets in state k that choose y last, given the counts `a` of the
-- subsets they extend. Every term is computed whatever y is, so the cost
-- does not depend on how many elements are 0.
let sc_choose a w y k =
  let c = k / 3 in
  let s = k mod 3 - 1 in
  let sy = sign y in
  let signed =
    addm
      (addm (sc_get a c 0) (sc_get a c sy))
      (addm (sc_get a (c - 1) (0 - sy)) (flag (c = w - 1) * sc_get a c (0 - sy))) in
  addm (flag (sy = 0) * array_get a k) ((1 - flag (sy = 0)) * flag (s = sy) * signed)

let sc_total a w m =
  loop (3 * w) 0 (fun k acc -> addm acc ((if k / 3 <= m then 1 else 0) * array_get a k))

let sign_changes_quadratic xs m =
  let w = sc_width m in
  let empty = array_tabulate (3 * w) (fun k -> if k = 1 then 1 else 0) in
  let ends =
    foldl
      (fun ends y ->
        let before = foldl (add_arrays (3 * w)) empty ends in
        array_tabulate (3 * w) (fun k -> sc_choose before w y k) :: ends)
      [] xs in
  sc_total (foldl (add_arrays (3 * w)) empty ends) w m

let sign_changes_good xs m =
  let w = sc_width m in
  let empty = array_tabulate (3 * w) (fun k -> if k = 1 then 1 else 0) in
  let counts =
    foldl
      (fun a y -> array_tabulate (3 * w) (fun k -> addm (array_get a k) (sc_choose a w y k)))
      empty xs in
  sc_total counts w m
