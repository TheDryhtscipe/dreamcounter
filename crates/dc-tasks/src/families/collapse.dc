-- Reference solutions of the collapse family (bead P3.7), in dc surface
-- syntax, compiled against the prelude. A list is rewritten by a local rule
-- on adjacent pairs, always at the leftmost pair the rule applies to (the
-- leftmost redex), until no pair is left. A rule is given by `redex x y`,
-- whether the pair x, y (x just left of y) is rewritten, and `replace x y`,
-- what it becomes: a list of at most one element.
--
-- * naive (n^2 when there are about n rewrites at depth about n): find the
--   leftmost redex from the front, rewrite it, start again.
-- * good (n): one pass with a stack of the elements so far, top first. The
--   stack never holds a redex, so the leftmost redex of the stack followed by
--   the rest of the list can only be the top and the next element; a
--   rewrite there makes its result the next element. Each element is pushed
--   and popped at most once.

-- One rewrite at the leftmost redex: (true, the list after it), or
-- (false, the list) when there is no redex.
let collapse_step redex replace xs =
  bfix (length xs + 1)
    (fun self ys ->
      match ys with
      | [] -> (false, ys)
      | x :: rest ->
        match rest with
        | [] -> (false, ys)
        | y :: rest2 ->
          if redex x y then (true, append (replace x y) rest2)
          else
            let (found, r) = self rest in (found, x :: r))
    xs

-- (the final list, the number of rewrites). Each rewrite shortens the list,
-- so there are fewer than length xs + 1 of them.
let collapse_naive_count redex replace xs =
  bfix (length xs + 1)
    (fun self (ys, k) ->
      let (found, r) = collapse_step redex replace ys in
      if found then self (r, k + 1) else (ys, k))
    (xs, 0)

-- Pushes x onto st (top first), rewriting while the top and x are a redex.
-- Returns (the stack, the number of rewrites).
let collapse_push redex replace st x =
  bfix (length st + 2)
    (fun self (st, x, k) ->
      match st with
      | [] -> ([x], k)
      | t :: rest ->
        if redex t x then
          match replace t x with
          | [] -> (rest, k + 1)
          | y :: _ -> self (rest, y, k + 1)
        else (x :: st, k))
    (st, x, 0)

let collapse_good_count redex replace xs =
  let (st, k) =
    foldl
      (fun (st, k) x ->
        let (st2, j) = collapse_push redex replace st x in (st2, k + j))
      ([], 0) xs in
  (reverse st, k)

-- (a) Merge: an equal pair x, x becomes x + 1.

let merge_redex x y = x = y

let merge_replace x y = [x + 1]

let merge_naive xs = fst (collapse_naive_count merge_redex merge_replace xs)

let merge_good xs = fst (collapse_good_count merge_redex merge_replace xs)

-- (b) Cancel: a pair summing to 0 disappears.

let cancel_redex x y = x + y = 0

let cancel_replace x y = []

let cancel_naive xs = fst (collapse_naive_count cancel_redex cancel_replace xs)

let cancel_good xs = fst (collapse_good_count cancel_redex cancel_replace xs)

-- (c) Absorb: x absorbs y when x - y >= 2, and the pair becomes (x + y) mod 10.

let absorb_redex x y = x - y >= 2

let absorb_replace x y = [(x + y) mod 10]

let absorb_naive xs = fst (collapse_naive_count absorb_redex absorb_replace xs)

let absorb_good xs = fst (collapse_good_count absorb_redex absorb_replace xs)

-- (d) Absorb count: the number of rewrites under the absorb rule.

let absorb_count_naive xs = snd (collapse_naive_count absorb_redex absorb_replace xs)

let absorb_count_good xs = snd (collapse_good_count absorb_redex absorb_replace xs)
